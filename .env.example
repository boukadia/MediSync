# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Database Configuration (MongoDB)
# ==========================================
# Local MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/medisync

# Docker Compose MongoDB connection
# MONGODB_URI=mongodb://mongodb:27017/medisync

# MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medisync?retryWrites=true&w=majority

# ==========================================
# JWT Authentication Secret
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRES_IN=24h

# ==========================================
# Frontend / CORS Origin
# ==========================================
CLIENT_URL=http://localhost:5173
